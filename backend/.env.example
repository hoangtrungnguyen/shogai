# Required — Gemini API key (https://aistudio.google.com/apikey).
# Values in this file take precedence over variables exported in your shell.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# SHOGAI_MODEL_ANALYZE=gemini-flash-latest      # image / text / video / audio / paper analysis
# SHOGAI_MODEL_SYNTHESIZE=gemini-flash-latest   # merging sources into profile.md
# SHOGAI_MODEL_ADVISOR=gemini-flash-latest      # chat; try gemini-pro-latest for deeper advice
# SHOGAI_ANALYZE_THINKING=low                   # minimal | low | medium | high
# SHOGAI_SYNTHESIZE_THINKING=medium
# SHOGAI_ADVISOR_THINKING=medium
# SHOGAI_LANGUAGE=English                       # language profiles are written in
# SHOGAI_DATA_DIR=data                          # relative to the repo root
# SHOGAI_KEEP_MEDIA=true                        # keep original uploads in people/<slug>/media
# SHOGAI_GEMINI_API_VERSION=v1beta
# SHOGAI_HOST=127.0.0.1
# SHOGAI_PORT=8000
