# Shōgai Relay settings for docker compose (copy to .env).

# A Shōgai app needs this code to open an account on the relay. Leave it empty and anyone who finds the
# relay can open one (they still can't see anyone else's requests).
SHOGAI_RELAY_SIGNUP_CODE=

# Host port for the relay (bound to 127.0.0.1).
RELAY_PORT=8090

# With `docker compose --profile https up -d`: the domain Caddy gets an HTTPS certificate for.
# Point its DNS at this machine first.
RELAY_DOMAIN=relay.example.com
